# EcoShield Configuration Example

# Database (PostgreSQL + PostGIS)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ecoshield_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis & Celery
REDIS_URL=redis://redis:6379/0

# Security (Generate strong random keys for production)
SECRET_KEY=generate_a_secure_jwt_secret_key_here
FERNET_KEY=ZWWExy1xxYvqf9zRjHOJHlCWPF7jzFeUD8Fz2wMh8JQ=
HMAC_SECRET=generate_a_secure_hmac_secret_here

# External APIs (Twilio SMS & Google Earth Engine)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
GEE_SERVICE_ACCOUNT=your_service_account@project.iam.gserviceaccount.com
GEE_PRIVATE_KEY_PATH=/app/secrets/gee-key.json
